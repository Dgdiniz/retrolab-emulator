{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@debugger-core": ["../debugger-core/src/index"],
      "@debugger-core/*": ["../debugger-core/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
